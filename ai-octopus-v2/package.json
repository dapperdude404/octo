{
  "name": "ai-octopus",
  "version": "5.1.0-rc.1",
  "private": true,
  "description": "AI Octopus writing intelligence — local pattern analysis, clarity, grammar, draft comparison and optional provider APIs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch server/src/index.js",
    "preview": "node scripts/preview.js",
    "start": "node server/src/index.js",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma --name init",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "web:build": "node scripts/build-web.js",
    "android:add": "npm run web:build && cap add android && node scripts/android-icon.js",
    "android:sync": "npm run web:build && cap sync android && node scripts/android-icon.js",
    "android:open": "cap open android",
    "test": "node --test server/test/*.test.js",
    "doctor": "node scripts/doctor.js",
    "web:sync": "node scripts/build-web.js --sync-mirrors",
    "web:check": "node scripts/build-web.js --check-mirrors",
    "prestart": "npm run web:build",
    "predev": "npm run web:build"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "zod": "^4.1.12",
    "docx": "^9.15.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "prisma": "^6.19.0"
  },
  "type": "module"
}
