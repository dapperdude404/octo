generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  scans        Scan[]
}

model Scan {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  kind        String   @default("ai")
  status      String   @default("queued")
  title       String?
  wordCount   Int      @default(0)
  result      Json?
  rawResult   Json?
  error       String?
  providerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([providerId])
}
