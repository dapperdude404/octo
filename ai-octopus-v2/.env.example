# Runtime
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=postgresql://octo:octo_dev_password@localhost:5432/octo?schema=public

# Optional commercial provider credentials. Keep these on the server only.
GPTZERO_API_KEY=
WINSTONAI_API_KEY=
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
COPYLEAKS_SANDBOX=true

# Optional: set to true only after configuring public HTTPS callback URL
COPYLEAKS_WEBHOOK_ENABLED=false
# Set a unique 24+ character secret when enabling Copyleaks callbacks.
COPYLEAKS_WEBHOOK_SECRET=
